DB_URL=jdbc:postgresql://localhost:5432/agrosphere_spatial
DB_USER=agrosphere_spatial
DB_PASSWORD=REPLACE_LOCALLY
RABBITMQ_HOST=localhost
RABBITMQ_USER=agrosphere
RABBITMQ_PASSWORD=REPLACE_LOCALLY
OIDC_ISSUER_URI=http://localhost:8180/realms/agrosphere
OIDC_AUDIENCE=spatial-service
OUTBOX_PUBLICATION_ENABLED=false
ESTATE_CONSUMER_ENABLED=false
MINIMUM_AREA_HECTARES=0
OVERLAP_TOLERANCE_HECTARES=0
MAX_BODY_BYTES=2097152
MAX_COORDINATES=20000
MAX_QUERY_BBOX_DEGREES=5

# Optional: internal JWKS address for containers; omit to retain issuer discovery.
# OIDC_JWK_SET_URI=http://keycloak:8080/realms/agrosphere/protocol/openid-connect/certs
