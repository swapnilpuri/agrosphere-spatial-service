{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrosphere.invalid/events/v2/PlantationBlockUpdated.schema.json",
  "title": "PlantationBlockUpdated v2",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "sourceService",
    "estateId",
    "entityId",
    "dataProvenance",
    "payload",
    "blockId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "PlantationBlockUpdated"
    },
    "eventVersion": {
      "const": 2
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceService": {
      "const": "estate-service"
    },
    "estateId": {
      "type": "string",
      "format": "uuid"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "dataProvenance": {
      "enum": [
        "REAL",
        "SIMULATED",
        "ESTIMATED",
        "PREDICTED"
      ]
    },
    "blockId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "id",
        "estateId",
        "divisionId",
        "blockCode",
        "name",
        "cropType",
        "rubberCloneCode",
        "plantingDate",
        "plantedAreaHectares",
        "plantedTreeCount",
        "tappableTreeCount",
        "status",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "estateId": {
          "type": "string",
          "format": "uuid"
        },
        "divisionId": {
          "type": "string",
          "format": "uuid"
        },
        "blockCode": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cropType": {
          "type": "string",
          "enum": [
            "RUBBER"
          ]
        },
        "rubberCloneCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
          "maxLength": 64
        },
        "plantingDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "plantedAreaHectares": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999.9999,
          "multipleOf": 0.0001
        },
        "plantedTreeCount": {
          "type": "integer",
          "minimum": 0
        },
        "tappableTreeCount": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
